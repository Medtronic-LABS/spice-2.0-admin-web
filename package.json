{
  "name": "spice_web",
  "version": "0.2.0",
  "private": true,
  "dependencies": {
    "@babel/core": "^7.29.0",
    "@reduxjs/toolkit": "^2.11.2",
    "axios": "^1.13.6",
    "axios-mock-adapter": "^2.1.0",
    "bootstrap": "^5.3.8",
    "browserslist": "^4.28.1",
    "crypto-js": "^4.1.1",
    "dompurify": "^3.3.3",
    "dotenv": "^17.3.1",
    "dotenv-expand": "^12.0.3",
    "file-saver": "^2.0.5",
    "final-form": "^5.0.0",
    "final-form-arrays": "^4.0.0",
    "history": "^5.0.1",
    "identity-obj-proxy": "^3.0.0",
    "jest": "^30.3.0",
    "jest-resolve": "^30.3.0",
    "jest-watch-typeahead": "^3.0.1",
    "jodit-react": "^5.3.21",
    "leaflet": "^1.9.4",
    "lodash": "^4.17.23",
    "lottie-web": "^5.13.0",
    "postcss": "^8.4.4",
    "react": "^19.2.4",
    "react-app-polyfill": "^3.0.0",
    "react-datepicker": "^9.1.0",
    "react-dom": "^19.2.4",
    "react-final-form": "^7.0.0",
    "react-final-form-arrays": "^4.0.0",
    "react-ga4": "^2.1.0",
    "react-leaflet": "^5.0.0",
    "react-redux": "^9.2.0",
    "react-router": "^7.13.1",
    "react-router-dom": "^7.13.1",
    "react-select": "^5.10.2",
    "react-toastify": "^11.0.5",
    "redux": "^5.0.1",
    "redux-mock-store": "^1.5.5",
    "reselect": "^5.1.1",
    "typed-redux-saga": "^1.3.1",
    "web-vitals": "^5.1.0"
  },
  "devDependencies": {
    "@babel/preset-env": "^7.29.0",
    "@babel/preset-react": "^7.28.5",
    "@babel/preset-typescript": "^7.28.5",
    "@eslint/js": "^9.39.4",
    "@svgr/rollup": "^8.1.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/bootstrap": "^5.2.10",
    "@types/crypto-js": "^4.1.1",
    "@types/dompurify": "^3.0.5",
    "@types/file-saver": "^2.0.7",
    "@types/jest": "^30.0.0",
    "@types/leaflet": "^1.9.15",
    "@types/lodash": "^4.17.24",
    "@types/node": "^25.5.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/redux-mock-store": "^1.5.0",
    "@typescript-eslint/eslint-plugin": "^8.57.0",
    "@typescript-eslint/parser": "^8.57.0",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "globals": "^17.4.0",
    "jest-canvas-mock": "^2.4.0",
    "jest-environment-jsdom": "^30.3.0",
    "jest-sonar-reporter": "^2.0.0",
    "sass": "^1.98.0",
    "sonarqube-scanner": "^4.3.5",
    "typescript": "^5.9.3",
    "vite": "^8.0.0"
  },
  "overrides": {
    "autoprefixer": "10.4.5"
  },
  "scripts": {
    "dev": "vite",
    "start": "vite",
    "build": "vite build",
    "winBuild": "vite build",
    "preview": "vite preview",
    "test": "node scripts/test.js --config ./package.json --watchAll=false --coverage --testResultsProcessor jest-sonar-reporter",
    "testOnly": "node scripts/test.js --config ./package.json",
    "lint": "eslint \"src/**/*.{ts,tsx}\"",
    "sonar": "node sonarqube.js"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "jest": {
    "roots": [
      "<rootDir>/src"
    ],
    "collectCoverageFrom": [
      "src/**/*.{js,jsx,ts,tsx}",
      "!src/**/*.d.ts"
    ],
    "setupFiles": [
      "react-app-polyfill/jsdom"
    ],
    "setupFilesAfterEnv": [
      "<rootDir>/src/setupTests.ts"
    ],
    "testMatch": [
      "<rootDir>/src/**/__tests__/**/*.{js,jsx,ts,tsx}",
      "<rootDir>/src/**/*.{spec,test}.{js,jsx,ts,tsx}"
    ],
    "testEnvironment": "jsdom",
    "transform": {
      "^.+\\.(js|jsx|mjs|cjs|ts|tsx)$": "<rootDir>/config/jest/babelTransform.js",
      "^.+\\.css$": "<rootDir>/config/jest/cssTransform.js",
      "^(?!.*\\.(js|jsx|mjs|cjs|ts|tsx|css|json)$)": "<rootDir>/config/jest/fileTransform.js"
    },
    "transformIgnorePatterns": [
      "[/\\\\]node_modules[/\\\\].+\\.(js|jsx|mjs|cjs|ts|tsx)$",
      "^.+\\.module\\.(css|sass|scss)$"
    ],
    "modulePaths": [],
    "moduleNameMapper": {
      "^react-native$": "react-native-web",
      "^.+\\.module\\.(css|sass|scss)$": "identity-obj-proxy"
    },
    "moduleFileExtensions": [
      "web.js",
      "js",
      "web.ts",
      "ts",
      "web.tsx",
      "tsx",
      "json",
      "web.jsx",
      "jsx",
      "node"
    ],
    "watchPlugins": [
      "jest-watch-typeahead/filename",
      "jest-watch-typeahead/testname"
    ],
    "clearMocks": true,
    "resetMocks": false
  }
}
